diff --git a/ports/alif/vfs_rom_ioctl.c b/ports/alif/vfs_rom_ioctl.c
index d82ac6f8..236d892d 100644
--- a/ports/alif/vfs_rom_ioctl.c
+++ b/ports/alif/vfs_rom_ioctl.c
@@ -24,6 +24,7 @@
  * THE SOFTWARE.
  */
 
+#include <string.h>
 #include "py/mperrno.h"
 #include "py/objarray.h"
 #include "py/runtime.h"
@@ -31,6 +32,7 @@
 #include "modalif.h"
 #include "mpu.h"
 #include "mram.h"
+#include "irq.h"
 #include "ospi_flash.h"
 
 #if MICROPY_VFS_ROM_IOCTL
@@ -145,15 +147,27 @@ mp_obj_t mp_vfs_rom_ioctl(size_t n_args, const mp_obj_t *args) {
         }
 
         if (mram_is_valid_addr(dest)) {
-            // Write data to MRAM.
+            // Write data to MRAM. The M55 executes in place from MRAM, and an MRAM location
+            // cannot be instruction-fetched while another is being programmed (a read-while-
+            // write hazard) -> HardFault. So, exactly like the bootloader's MRAM writer: mask
+            // IRQs so no interrupt handler is fetched from MRAM mid-program, AND program with a
+            // tight in-line store loop -- no call to an out-of-line helper (mram_write_128bit),
+            // whose own fetch from MRAM would collide with the write even with IRQs masked. The
+            // small loop stays in the I-cache, so no MRAM instruction fetch overlaps a program.
+            // Save/restore PRIMASK so nested masking is preserved.
             mpu_config_mram(false);
             const uint8_t *src = bufinfo.buf;
-            const uint8_t *max = src + bufinfo.len;
-            while (src < max) {
-                mram_write_128bit((uint8_t *)dest, src);
+            const uint8_t *end = src + bufinfo.len;
+            uint32_t irq_state = disable_irq();
+            while (src < end) {
+                uint64_t w[2];                          // one 16-byte MRAM sector; the source
+                memcpy(w, src, sizeof(w));              // may be unaligned (const size -> inlined)
+                ((volatile uint64_t *)dest)[0] = w[0];  // 128-bit program: two 64-bit stores
+                ((volatile uint64_t *)dest)[1] = w[1];
                 dest += MRAM_SECTOR_SIZE;
                 src += MRAM_SECTOR_SIZE;
             }
+            enable_irq(irq_state);
             mpu_config_mram(true);
             return MP_OBJ_NEW_SMALL_INT(0); // success
         }
